---
import PricingTag from '../ui/PricingTag.astro';
interface Props{number:string;title:string;description:string;tag?:string;variant?:'dark'|'light';}
const {number,title,description,tag='Под заказ',variant='dark'}=Astro.props;
---
<article class:list={['work-stage','work-stage--'+variant]}>
  <div class="work-stage__text">
    <span class="stage-number">{number}</span>
    <h3 class="type-h4">{title}</h3>
    <p>{description}</p>
  </div>
  <PricingTag label={tag} inverse={variant==='light'}/>
</article>
<style>
/* Figma element_Work Stage 88:2689 — 300×320 Desktop, 260×280 Mobile */
.work-stage{box-sizing:border-box;width:300px;max-width:100%;height:320px;min-height:320px;padding:16px;display:flex;flex-direction:column;justify-content:space-between;gap:24px;background:var(--color-black);border-radius:4px;color:var(--color-white)}
.stage-number{display:grid;place-items:center;background:var(--color-green);color:var(--color-black);width:24px;height:24px;border-radius:50%;font:700 12px/1.2 var(--font-body)}
.work-stage h3{margin-top:4px;font:700 24px/1.25 var(--font-heading)}
.work-stage p{margin-top:12px;font:500 16px/1.25 var(--font-body);color:var(--color-gray-4)}
.work-stage--light{background:var(--color-milk);color:var(--color-black)}
.work-stage--light p{color:inherit}
.work-stage--light .stage-number{background:var(--color-black);color:var(--color-green)}
@media(max-width:58rem){
 .work-stage{width:260px;height:280px;min-height:280px}
 .work-stage h3{font-size:20px;line-height:1.3}
 .work-stage p{font-size:14px;line-height:1.25}
}
</style>

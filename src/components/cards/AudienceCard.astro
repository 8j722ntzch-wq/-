---
import assets from '../../data/figma-assets.json';
interface Props{eyebrow:string;title:string;illustration:string;}
const {eyebrow,title,illustration}=Astro.props;
const desktop=assets.find(a=>a.name===illustration);
const mobile=assets.find(a=>a.name===illustration+'-mobile');
if(!desktop||!mobile)throw new Error('Missing illustration_For who? variants: '+illustration);
---
<article class="audience-card" data-illustration-group="illustration_For who?">
  <p class="type-superscript">{eyebrow}</p>
  <h3 class="type-h4">{title}</h3>
  <picture>
    <source media="(max-width: 58rem)" srcset={mobile.src}/>
    <img src={desktop.src} width={desktop.width} height={desktop.height} alt="" loading="lazy"/>
  </picture>
</article>
<style>
/* Figma block_Услуга 183:7337 — this set is the "For who" card (not 51:1626).
   404×431 Desktop, 340×344 Mobile. */
.audience-card{box-sizing:border-box;position:relative;width:100%;max-width:404px;height:431px;min-height:431px;padding:20px;border-radius:4px;background:#fefefe33;color:var(--color-white);display:flex;flex-direction:column;gap:8px;overflow:hidden}
.audience-card .type-superscript{font:700 12px/1.2 var(--font-body);text-transform:uppercase}
.audience-card h3{font:700 24px/1.25 var(--font-heading);position:relative;z-index:1}
.audience-card picture{position:absolute;left:50%;bottom:10px;transform:translateX(-50%);width:320px;height:320px;max-width:100%;display:block}
.audience-card img{display:block;width:100%;height:100%;object-fit:contain}
@media(max-width:58rem){
 .audience-card{max-width:340px;height:344px;min-height:344px}
 .audience-card h3{font-size:20px;line-height:1.3}
 .audience-card picture{width:240px;height:240px}
}
</style>

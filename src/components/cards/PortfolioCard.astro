---
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
interface Props { title:string;image:string;imageAlt:string;audience:string;price:string;quantity:string;ownItem?:boolean;tag:string;tone?:'blue'|'pink';dialogId?:string;home?:boolean; }
const {title,image,imageAlt,audience,price,quantity,ownItem=false,tag,tone='blue',dialogId='consultation',home=false}=Astro.props;
---
<article class:list={['portfolio-card',{'portfolio-card--home':home}]} style={`--portfolio-accent:var(--color-${tone})`}><div class="portfolio-image"><img src={image} width="612" height="344" alt={imageAlt} loading="lazy"/><span class:list={['portfolio-tag',`portfolio-tag--${tone}`]}>{tag}</span></div><div class="portfolio-meta"><span><Icon name={audience==='Для бизнеса'||audience==='Бизнесу'?'business':'personal'} size={20}/>{audience}</span><span><Icon name="price" size={20}/>{price}</span>{ownItem&&<span><Icon name="own-item" size={20}/>Своя вещь</span>}</div><h3><strong>Проект:</strong> {title}</h3><p class="portfolio-volume"><strong>{home?'Объём:':'Объём заказа:'}</strong> {quantity}</p><Button variant="linear" size="m" fullWidth icon openDialog={dialogId} service={tag} context={'Проект: '+title}>{home?'Узнать больше о работе':'Хочу так же'}</Button></article>
<style>.portfolio-card--home .portfolio-volume{font:500 20px/1.3 var(--font-body);margin-top:-12px}.portfolio-card--home .portfolio-volume strong{font-family:var(--font-heading)}.portfolio-card--home .portfolio-meta{text-transform:uppercase}.portfolio-card--home .portfolio-meta :global(.icon){color:var(--portfolio-accent)}.portfolio-card--home .portfolio-tag{display:flex;align-items:center;gap:4px;color:var(--color-white)}.portfolio-card--home .portfolio-tag::before{content:'';width:8px;height:8px;border-radius:50%;background:currentColor}.portfolio-card--home{min-height:506px}</style>
<style>.portfolio-card{min-width:0;display:flex;flex-direction:column;gap:12px}.portfolio-image{position:relative;overflow:hidden;border-radius:4px}.portfolio-image>img{width:100%;aspect-ratio:612/344;object-fit:cover}.portfolio-tag{position:absolute;left:20px;bottom:20px;background:var(--color-blue);color:var(--color-white);padding:4px 8px;border-radius:500px;font:700 12px/1.2 var(--font-body);text-transform:uppercase}.portfolio-tag--pink{background:var(--color-pink);color:var(--color-black)}.portfolio-meta{display:flex;gap:12px 24px;flex-wrap:wrap;font-size:12px}.portfolio-meta>span{display:flex;gap:8px;align-items:center}.portfolio-card h3{font:500 20px/1.3 var(--font-body)}.portfolio-card h3 strong{font-family:var(--font-heading)}.portfolio-volume{font-size:14px;margin-top:-8px}.portfolio-card>:last-child{margin-top:auto}</style>

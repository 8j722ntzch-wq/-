---
import Icon from '../ui/Icon.astro';
interface Props { eyebrow:string;title:string;description:string;icon?:string;variant?:'light'|'blue'; }
const {eyebrow,title,description,icon='calculator',variant='light'}=Astro.props;
---
<article class:list={['advantage-card',`advantage-card--${variant}`]}><span class="advantage-icon"><Icon name={icon} size={32}/></span><div><p class="type-superscript">{eyebrow}</p><h3 class="type-h4">{title}</h3><p class="advantage-description">{description}</p></div></article>
<style>.advantage-card{padding:24px;border-radius:4px;background:var(--color-white);display:grid;align-content:start;gap:16px;min-height:244px}.advantage-icon{display:grid;place-items:center;width:48px;height:48px;border-radius:50%;background:var(--color-blue);color:var(--color-white)}.advantage-card h3{margin-top:8px}.advantage-description{margin-top:8px}.advantage-card--blue{color:var(--color-white);background:var(--color-blue)}.advantage-card--blue .advantage-icon{color:var(--color-blue);background:var(--color-white)}</style>

---
import Icon from '../ui/Icon.astro';
interface Props {eyebrow:string;title:string;description:string;icon?:string;variant?:'light'|'blue';compact?:boolean;}
const {eyebrow,title,description,icon='calculator',variant='light',compact=false}=Astro.props;
---
<article class:list={['advantage-card','advantage-card--'+variant,{'advantage-card--compact':compact}]}>
  <span class="advantage-icon"><Icon name={icon} size={32}/></span>
  <div class="advantage-copy">
    <p class="type-superscript">{eyebrow}</p>
    <h3 class="type-h4">{title}</h3>
    <p class="advantage-description">{description}</p>
  </div>
</article>
<style>
/* element_Advantages 77:4419 — 404×212 Desktop, 340×192 Mobile */
.advantage-card{box-sizing:border-box;width:100%;max-width:404px;min-height:212px;padding:24px;border-radius:4px;background:var(--color-white);display:grid;align-content:start;gap:16px;overflow-wrap:anywhere}
.advantage-icon{display:grid;place-items:center;width:48px;height:48px;border-radius:50%;background:var(--color-blue);color:var(--color-white)}
.advantage-copy{display:grid;gap:8px}
.advantage-copy .type-superscript{font:700 12px/1.2 var(--font-body);color:var(--color-blue)}
.advantage-copy h3{font:700 24px/1.25 var(--font-heading)}
.advantage-description{font:500 16px/1.25 var(--font-body);color:var(--color-gray-4)}
.advantage-card--blue{color:var(--color-white);background:var(--color-blue)}
.advantage-card--blue .advantage-icon{color:var(--color-blue);background:var(--color-white)}
.advantage-card--blue .type-superscript,.advantage-card--blue .advantage-description{color:var(--color-white)}
.advantage-card--compact:not(.advantage-card--blue) .type-superscript{color:var(--color-blue)}
@media(max-width:58rem){
 .advantage-card{max-width:340px;min-height:192px}
 .advantage-icon{width:36px;height:36px}
 .advantage-icon :global(.icon){width:24px;height:24px}
 .advantage-copy h3{font-size:20px;line-height:1.3}
 .advantage-description{font-size:14px;line-height:1.25}
}
</style>

---
import ActionLink from '../ui/ActionLink.astro';
import Button from '../ui/Button.astro';
import PricingTag from '../ui/PricingTag.astro';
import assets from '../../data/figma-assets.json';
interface Props { title:string;description:string;illustration:string;href?:string;size?:'m'|'l';tag?:string;dialogId?:string;actionLabel?:string; }
const {title,description,illustration,href='#forms',size='m',tag,dialogId,actionLabel='Узнать больше'}=Astro.props;
const asset=assets.find(a=>a.name===illustration)!;
---
<article data-illustration-group="illustration_Services" class:list={['service-card',`service-card--${size}`]}>
 {dialogId
  ? <button type="button" class="service-card__overlay" data-open-dialog={dialogId} data-service={title} data-context={title} aria-label={`Оставить заявку: ${title}`}></button>
  : <a class="service-card__overlay" href={href} aria-label={`Подробнее об услуге: ${title}`}></a>}
 <div class="service-content">{tag&&<PricingTag label={tag}/>}<h3 class="type-h4">{title}</h3><p>{description}</p></div>
 <img src={asset.src} width={asset.width} height={asset.height} alt="" loading="lazy"/>
 <div class="service-action">{dialogId?<Button variant="linear" size="m" fullWidth={size==='m'} icon openDialog={dialogId} service={title} context={title}>{actionLabel}</Button>:<ActionLink href={href} variant="linear" size="m" fullWidth icon>{actionLabel}</ActionLink>}</div>
</article>
<style>.service-card{display:flex;flex-direction:column;background:var(--color-white);border-radius:4px;padding:20px;min-width:0;min-height:466px;position:relative}.service-content{display:grid;gap:8px}.service-content>p{color:var(--color-gray-4);font-size:16px}.service-content :global(.pricing-tag){margin-bottom:4px}.service-card>img{width:240px;height:240px;object-fit:contain;margin:auto;max-width:100%}.service-action{margin-top:auto}.service-card--l{min-height:280px;display:grid;grid-template-columns:minmax(0,1fr) minmax(140px,240px);grid-template-rows:1fr auto;gap:16px}.service-card--l>img{grid-column:2;grid-row:1/3}.service-card--l .service-action{grid-row:2}.service-card--l .service-content{align-content:start}.service-card--l :global(.button__label){padding-inline:10px}@media(max-width:39rem){.service-card--l{display:flex;min-height:466px}.service-card--l>img{margin:auto}.service-card--l .service-action{margin-top:auto}}
.service-card__overlay{position:absolute;inset:0;z-index:1;display:block;width:100%;height:100%;padding:0;border:0;border-radius:inherit;background:transparent;cursor:pointer}
.service-card__overlay:focus-visible{outline:3px solid var(--color-blue);outline-offset:3px}
.service-action{position:relative;z-index:2}
@media(hover:hover) and (pointer:fine){
 .service-card:hover :global(.service-action .button--linear){--button-bg:var(--color-green);--button-border:transparent}
}
.service-card:focus-within :global(.service-action .button--linear){--button-bg:var(--color-green);--button-border:transparent}
</style>

---
import assets from '../../data/figma-assets.json';
interface Props{title:string;href:string;illustration:string;}
const {title,href,illustration}=Astro.props;
const asset=assets.find(item=>item.name===illustration);
if(!asset)throw new Error('Unknown service-menu illustration: '+illustration);
---
<a class="service-menu-item" href={href} data-ui-component="element_Button">
  <img src={asset.src} width={asset.width} height={asset.height} alt="" loading="lazy"/>
  <span>{title}</span>
</a>
<style>
.service-menu-item{display:flex;flex-direction:column;justify-content:flex-start;align-items:center;gap:12px;width:100%;height:182px;min-width:0;padding:10px 20px 20px;border-radius:4px;background:var(--color-white);color:var(--color-black);text-decoration:none}
.service-menu-item img{width:120px;height:120px;object-fit:contain}
.service-menu-item span{width:100%;text-align:center;font:500 16px/1.25 var(--font-body);letter-spacing:0;overflow-wrap:anywhere}
.service-menu-item:hover,.service-menu-item:focus-visible{background:var(--color-green)}
.service-menu-item:hover span,.service-menu-item:focus-visible span{text-decoration:underline}
.service-menu-item:active{background:var(--color-white)}
@media(max-width:58rem){
.service-menu-item{height:116px;gap:4px;padding:6px 12px 12px}
.service-menu-item img{width:80px;height:80px}
.service-menu-item span{font-size:12px;line-height:1.2}
}
</style>

---
import PortfolioCard from '../cards/PortfolioCard.astro';
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import { portfolioCategories, previewPortfolio } from '../../data/portfolio';
---
<portfolio-catalog class="portfolio-catalog">
  <div class="portfolio-tabs" role="group" aria-label="Фильтр работ по услуге">
    {portfolioCategories.map((category,index)=><button type="button" class="portfolio-tab" data-filter={category} aria-pressed={index===0?'true':'false'}>{category}</button>)}
  </div>
  <div class="portfolio-catalog__grid">
    {previewPortfolio.map(project=><div class="portfolio-catalog__item" data-category={project.tag} data-preview-position={project.previewPosition}><PortfolioCard {...project} home /></div>)}
  </div>
  <nav class="portfolio-pages" aria-label="Страницы портфолио">
    <button type="button" class="portfolio-pages__arrow portfolio-pages__arrow--previous" aria-label="Предыдущая страница" data-page-change="-1" disabled><Icon name="arrow-latex"/></button>
    <span class="portfolio-pages__numbers">
      {[1,2,3,4].map(number=><span class="portfolio-pages__number"><Button id={'portfolio-page-'+number} variant="text" size="s">{number}</Button></span>)}
    </span>
    <button type="button" class="portfolio-pages__arrow portfolio-pages__arrow--next" aria-label="Следующая страница" data-page-change="1" disabled><Icon name="arrow-latex"/></button>
  </nav>
</portfolio-catalog>
<script>
class PortfolioCatalog extends HTMLElement {
  connectedCallback(){
    const tabs=Array.from(this.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const items=Array.from(this.querySelectorAll<HTMLElement>('.portfolio-catalog__item'));
    const pages=this.querySelector<HTMLElement>('.portfolio-pages')!;
    const numberButtons=Array.from(this.querySelectorAll<HTMLButtonElement>('.portfolio-pages__numbers button'));
    const previous=this.querySelector<HTMLButtonElement>('[data-page-change="-1"]')!;
    const next=this.querySelector<HTMLButtonElement>('[data-page-change="1"]')!;
    // Four real pages from the available preview positions; no fabricated work.
    const maxPages=4;
    const categoryFromUrl=()=>{
      const requested=new URL(window.location.href).searchParams.get('category');
      return tabs.some(tab=>tab.dataset.filter===requested)?requested!:'Все';
    };
    let category=categoryFromUrl(),currentPage=1;
    const render=()=>{
      const filtered=items.filter(item=>category==='Все'||item.dataset.category===category);
      const count=Math.min(maxPages,Math.max(1,filtered.length));
      currentPage=Math.min(currentPage,count);
      const perPage=Math.floor(filtered.length/count);
      const extra=filtered.length%count;
      const start=(currentPage-1)*perPage+Math.min(currentPage-1,extra);
      const itemsOnPage=perPage+(currentPage<=extra?1:0);
      const visible=new Set(filtered.slice(start,start+itemsOnPage));
      items.forEach(item=>{item.hidden=!visible.has(item);});
      tabs.forEach(tab=>tab.setAttribute('aria-pressed',String(tab.dataset.filter===category)));
      pages.hidden=filtered.length===0;
      previous.disabled=currentPage===1;
      next.disabled=currentPage===count;
      numberButtons.forEach((button,index)=>{
        const number=index+1;
        button.disabled=number>count||filtered.length===0;
        button.dataset.page=String(number);
        button.setAttribute('aria-label','Страница '+number);
        if(number===currentPage&&filtered.length)button.setAttribute('aria-current','page');
        else button.removeAttribute('aria-current');
        button.title=button.disabled?'Пока нет работ для этой страницы':'';
      });
    };
    this.addEventListener('click',event=>{
      const target=event.target as Element|null;
      const tab=target?.closest<HTMLButtonElement>('[data-filter]');
      const number=target?.closest<HTMLButtonElement>('[data-page]');
      const arrow=target?.closest<HTMLButtonElement>('[data-page-change]');
      if(tab){
        const selected=tab.dataset.filter||'Все';
        if(selected!==category){
          category=selected;
          currentPage=1;
          const url=new URL(window.location.href);
          if(category==='Все')url.searchParams.delete('category');
          else url.searchParams.set('category',category);
          window.history.pushState({portfolioCategory:category},'',url.pathname+url.search+url.hash);
          render();
        }
      }
      else if(number){currentPage=Number(number.dataset.page);render();}
      else if(arrow&&!arrow.disabled){currentPage+=Number(arrow.dataset.pageChange);render();}
    });
    const onHistoryChange=()=>{category=categoryFromUrl();currentPage=1;render();};
    window.addEventListener('popstate',onHistoryChange);
    this.addEventListener('portfolio-catalog-disconnect',()=>window.removeEventListener('popstate',onHistoryChange),{once:true});
    render();
  }
  disconnectedCallback(){this.dispatchEvent(new Event('portfolio-catalog-disconnect'));}
}
if(!customElements.get('portfolio-catalog'))customElements.define('portfolio-catalog',PortfolioCatalog);
</script>
<style>
.portfolio-catalog{display:block;min-width:0}
.portfolio-tabs{display:flex;gap:4px;flex-wrap:wrap;margin-bottom:32px}
.portfolio-tab{border:1.5px solid var(--color-black);border-radius:4px;padding:12px;color:var(--color-black);background:transparent;font:700 14px/1.3 var(--font-body);letter-spacing:0em}
.portfolio-tab[aria-pressed=true]{border-color:var(--color-green);background:var(--color-green)}
.portfolio-tab:hover:not([aria-pressed=true]){background:var(--color-white)}
.portfolio-catalog__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.portfolio-catalog__item{min-width:0;width:100%}
.portfolio-pages{display:flex;justify-content:center;align-items:center;gap:24px;margin-top:48px}
.portfolio-pages__numbers{display:flex;gap:12px;align-items:center}
.portfolio-pages__number{display:inline-flex;align-items:center}
.portfolio-pages__number :global(.button--text){min-width:20px;justify-content:center;border:0;background:transparent;padding:4px 0;font:500 14px/1.3 var(--font-body);color:var(--color-black)}
.portfolio-pages__number :global(.button--text[aria-current=page]){font-weight:700;color:var(--color-blue);text-decoration:underline}
.portfolio-pages__number :global(.button--text:hover:not(:disabled)){color:var(--color-blue);text-decoration:underline}
.portfolio-pages__number :global(.button--text:disabled){color:var(--color-gray-3);cursor:default}
.portfolio-pages__arrow{display:grid;place-items:center;width:36px;height:36px;border:0;border-radius:4px;background:var(--color-black);color:var(--color-white)}
.portfolio-pages__arrow:disabled{background:none;color:var(--color-gray-3);border:1.5px solid var(--color-gray-3)}
.portfolio-pages__arrow--previous :global(.icon){transform:rotate(90deg)}
.portfolio-pages__arrow--next :global(.icon){transform:rotate(-90deg)}
/* Portfolio_All (Mobile) Figma 223:21351: 340px viewport, one column,
   single-row scrollable tabs and 24px before pagination. */
@media(max-width:58rem){
 .portfolio-catalog{width:100%;min-width:0}
 .portfolio-tabs{width:calc(100% + 25px);max-width:none;margin-right:-25px;padding-right:25px;height:38px;min-height:38px;display:flex;flex-wrap:nowrap;align-items:stretch;gap:4px;margin-bottom:24px;overflow-x:auto;overscroll-behavior-x:contain;scrollbar-width:none;scroll-snap-type:x proximity;scroll-padding-right:25px;-webkit-overflow-scrolling:touch}
 .portfolio-tabs::-webkit-scrollbar{display:none}
 .portfolio-tab{flex:0 0 auto;min-height:38px;padding:9px 10px;font:700 12px/1.2 var(--font-body);white-space:nowrap;scroll-snap-align:start}
 .portfolio-catalog__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
 .portfolio-catalog__item{width:100%;max-width:none}
 .portfolio-pages{margin-top:24px;gap:24px}
 .portfolio-pages__numbers{gap:12px}
 .portfolio-pages__arrow{height:36px;width:36px}
}
@media(max-width:40rem){
 .portfolio-catalog__grid{grid-template-columns:minmax(0,1fr)}
}
</style>

---
import SectionHeading from '../ui/SectionHeading.astro';
import PortfolioCard from '../cards/PortfolioCard.astro';
import Icon from '../ui/Icon.astro';
import { portfolioProjects } from '../../data/portfolio';
---
<section id="portfolio" class="portfolio-showcase container" aria-labelledby="related-portfolio-title">
  <SectionHeading id="related-portfolio-title" eyebrow="Портфолио">
    Смотрите наши другие работы
    <a slot="action" href="/portfolio/" class="portfolio-showcase__more">Смотреть все работы<span><Icon name="arrow" size={14}/></span></a>
  </SectionHeading>
  <div class="portfolio-showcase__grid">{portfolioProjects.map(project=><PortfolioCard {...project} home />)}</div>
</section>
<style>
.portfolio-showcase{display:grid;gap:24px}
.portfolio-showcase__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.portfolio-showcase__more{display:inline-flex;align-items:center;gap:6px;text-decoration:none;font:500 14px/1.25 var(--font-body)}
.portfolio-showcase__more:hover{text-decoration:underline}
.portfolio-showcase__more>span{display:grid;place-items:center;width:20px;height:20px;border-radius:50%;background:var(--color-black);color:var(--color-green)}
@media(max-width:55rem){.portfolio-showcase__grid{grid-template-columns:1fr}}
</style>

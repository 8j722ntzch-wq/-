---
/**
 * City-level Yandex map. Never draw a business marker until the real
 * location is confirmed. The coordinates only identify central Vitebsk.
 * JS API v3 key is public and must be restricted by HTTP Referer.
 */
const apiKey=(import.meta.env.PUBLIC_YANDEX_MAPS_API_KEY ?? '').trim();
const widget='https://yandex.ru/map-widget/v1/?ll=30.1844%2C55.1964&z=11';
const external='https://yandex.by/maps/154/vitebsk/';
---
<yandex-city-map class="yandex-city-map" data-api-key={apiKey} data-mode={apiKey?'api':'widget'}>
  <div class="yandex-city-map__canvas" role="region" aria-label="Интерактивная карта Витебска без метки мастерской">
    {apiKey
      ? <div class="yandex-city-map__api" data-yandex-canvas></div>
      : <iframe src={widget} title="Яндекс Карта Витебска без адреса мастерской" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
    }
  </div>
  <div class="yandex-city-map__info">
    <span><strong>Витебск</strong> · Точный адрес и отметку мастерской добавим позже</span>
    <a href={external} target="_blank" rel="noopener noreferrer">Открыть Яндекс Карты</a>
  </div>
  <p class="yandex-city-map__error" role="status" hidden>Не удалось загрузить API карты. Доступен интерактивный виджет Яндекс Карт.</p>
</yandex-city-map>
<script>
type MapInstance={addChild:(layer:unknown)=>MapInstance};
type MapsApi={
  ready:Promise<unknown>;
  YMap:new (root:HTMLElement,props:{location:{center:[number,number];zoom:number}})=>MapInstance;
  YMapDefaultSchemeLayer:new ()=>unknown;
  YMapDefaultFeaturesLayer?:new ()=>unknown;
};
class YandexCityMap extends HTMLElement{
  connectedCallback(){
    const key=this.dataset.apiKey;
    if(!key)return;
    const root=this.querySelector<HTMLElement>('[data-yandex-canvas]');
    if(!root)return;
    const showFallback=()=>{
      if(!this.isConnected)return;
      this.dataset.mode='widget-fallback';
      root.replaceChildren();
      const frame=document.createElement('iframe');
      frame.src='https://yandex.ru/map-widget/v1/?ll=30.1844%2C55.1964&z=11';
      frame.title='Яндекс Карта Витебска без адреса мастерской';
      frame.loading='lazy';
      frame.referrerPolicy='strict-origin-when-cross-origin';
      frame.allowFullscreen=true;
      frame.style.width='100%';frame.style.height='100%';frame.style.border='0';
      root.append(frame);
      const error=this.querySelector<HTMLElement>('.yandex-city-map__error');
      if(error)error.hidden=false;
    };
    const loader=document.createElement('script');
    loader.src='https://api-maps.yandex.ru/v3/?apikey='+encodeURIComponent(key)+'&lang=ru_RU';
    loader.async=true;
    loader.onerror=showFallback;
    loader.onload=async()=>{
      try{
        const api=(window as Window&{ymaps3?:MapsApi}).ymaps3;
        if(!api)throw new Error('Yandex Maps API unavailable');
        await api.ready;
        if(!this.isConnected)return;
        const map=new api.YMap(root,{location:{center:[30.1844,55.1964],zoom:11}});
        map.addChild(new api.YMapDefaultSchemeLayer());
        if(api.YMapDefaultFeaturesLayer)map.addChild(new api.YMapDefaultFeaturesLayer());
        this.dataset.mode='api-ready';
      }catch{
        showFallback();
      }
    };
    document.head.append(loader);
  }
}
if(!customElements.get('yandex-city-map'))customElements.define('yandex-city-map',YandexCityMap);
</script>
<style>
.yandex-city-map{display:block;position:relative;width:100%;height:671px;min-height:671px;background:var(--color-gray-1);overflow:hidden;isolation:isolate}
.yandex-city-map__canvas,.yandex-city-map__api,.yandex-city-map__canvas iframe{display:block;width:100%;height:100%;border:0}
.yandex-city-map__info{position:absolute;z-index:1;left:max(16px,calc((100vw - var(--container))/2));bottom:24px;display:flex;align-items:center;gap:16px;flex-wrap:wrap;max-width:calc(100% - 32px);padding:12px 16px;background:var(--color-white);color:var(--color-black);border-radius:4px;box-shadow:var(--shadow);font:500 12px/1.4 var(--font-body)}
.yandex-city-map__info strong{font-weight:700}
.yandex-city-map__info a{font-weight:700;text-decoration:underline}
.yandex-city-map__error{position:absolute;z-index:2;top:16px;left:16px;padding:12px 16px;background:var(--color-white);border-radius:4px;font:500 12px/1.4 var(--font-body)}
@media(max-width:55rem){.yandex-city-map{height:460px;min-height:460px}.yandex-city-map__info{bottom:12px;gap:8px}}
</style>

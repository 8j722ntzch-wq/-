---
import PrintFormatCard from '../ui/PrintFormatCard.astro';
import Icon from '../ui/Icon.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import '../../styles/slider.css';
interface Props { heading:string; eyebrow:string; }
const {heading,eyebrow}=Astro.props;
const [firstLine,secondLine]=heading.split('\n');
const formats=[
 {illustration:'tshirt-a3' as const,title:'А3: Грудь',description:'Зона нанесения А3 на груди футболки'},
 {illustration:'jersey' as const,title:'А4: Спина',description:'Зона нанесения А4 на спине джерси'},
 {illustration:'vest' as const,title:'А5: Лого на спине',description:'Зона нанесения А5 на спине жилета'},
 {illustration:'polo' as const,title:'А6/А7: Лого на груди',description:'Зона нанесения А6/А7 на груди поло'},
 {illustration:'cap' as const,title:'А7: Кепка',description:'Зона нанесения А7 на кепке'},
 {illustration:'work-jacket' as const,title:'А7: Рукав',description:'Зона нанесения А7 на рукаве рабочей куртки'},
];
---
<print-formats aria-label="Форматы нанесения" role="region">
 <div class="formats-heading">
  <SectionHeading as="h1" id="service-title" eyebrow={eyebrow}>{firstLine}<br/>{secondLine}</SectionHeading>
  <div class="format-controls" role="group" aria-label="Переключение форматов нанесения">
   <button class="slider-button" type="button" aria-label="Предыдущие форматы" aria-controls="print-formats-track" disabled><Icon name="arrow-latex" size={18}/></button>
   <button class="slider-button" type="button" aria-label="Следующие форматы" aria-controls="print-formats-track"><Icon name="arrow-latex" size={18}/></button>
  </div>
 </div>
 <div class="format-track" id="print-formats-track" tabindex="0" aria-label="Шесть форматов нанесения">{formats.map(format=><PrintFormatCard {...format}/>)}</div>
</print-formats>
<script>
class PrintFormats extends HTMLElement{
 private observer?:ResizeObserver;
 connectedCallback(){
  const track=this.querySelector<HTMLElement>('.format-track')!;
  const [previous,next]=Array.from(this.querySelectorAll('button'));
  const update=()=>{previous.disabled=track.scrollLeft<=1;next.disabled=track.scrollLeft+track.clientWidth>=track.scrollWidth-2;};
  const move=(direction:number)=>{const first=track.firstElementChild as HTMLElement|null;const gap=parseFloat(getComputedStyle(track).columnGap)||12;const step=(first?.getBoundingClientRect().width||300)+gap;track.scrollBy({left:direction*step,behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'});};
  previous.addEventListener('click',()=>move(-1));next.addEventListener('click',()=>move(1));
  track.addEventListener('keydown',event=>{if(event.key==='ArrowLeft'||event.key==='ArrowRight'){event.preventDefault();move(event.key==='ArrowLeft'?-1:1);}});
  track.addEventListener('scroll',update,{passive:true});this.observer=new ResizeObserver(update);this.observer.observe(track);update();
 }
 disconnectedCallback(){this.observer?.disconnect();}
}
if(!customElements.get('print-formats'))customElements.define('print-formats',PrintFormats);
</script>
<style>
print-formats{display:flex;flex-direction:column;gap:24px;min-width:0}
.formats-heading{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;min-width:0}
.formats-heading :global(.heading){flex:1;min-width:0}
.format-controls{display:flex;flex:0 0 auto;gap:8px;align-items:center}
.format-controls button:first-child :global(.icon){transform:rotate(90deg)}
.format-controls button:last-child :global(.icon){transform:rotate(-90deg)}
.format-track{display:grid;grid-auto-flow:column;grid-auto-columns:300px;gap:12px;min-width:0;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;overscroll-behavior-x:contain}
.format-track :global(article){scroll-snap-align:start}
.format-track::-webkit-scrollbar{display:none}
@media(min-width:80rem){
 .format-track{margin-right:calc((var(--container) - 100vw)/2);padding-right:calc((100vw - var(--container))/2)}
}
@media(max-width:58rem){
 .formats-heading{display:contents}
 .formats-heading :global(.heading){order:0}
 .format-track{order:1;width:calc(100% + 25px);max-width:none;grid-auto-columns:260px}
 .format-controls{order:2;align-self:flex-end}
}
</style>

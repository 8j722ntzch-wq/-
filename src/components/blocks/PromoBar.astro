---
import Icon from '../ui/Icon.astro';
interface Props { text:string; href:string; linkLabel?:string; }
const {text,href,linkLabel='Узнать больше'}=Astro.props;
---
<aside class="promo"><p>{text}</p><span class="promo-dot" aria-hidden="true"></span><a href={href}>{linkLabel}<span class="promo-arrow"><Icon name="arrow" size={14}/></span></a></aside>
<style>.promo{background:var(--color-green);color:var(--color-black);min-height:30px;display:flex;justify-content:center;align-items:center;gap:12px;padding:6px 16px;font-size:14px;flex-wrap:wrap}.promo p{font-weight:700;text-transform:uppercase}.promo a{display:inline-flex;align-items:center;gap:6px;text-decoration:none}.promo a:hover{text-decoration:underline}.promo-arrow{display:grid;place-items:center;width:20px;height:20px;border-radius:50%;background:var(--color-black);color:var(--color-green)}.promo-dot{width:7px;height:7px;border-radius:50%;background:var(--color-black);box-shadow:0 0 3px 2px #0d0d0d33}@media(max-width:40rem){.promo{font-size:12px;gap:6px 12px;text-align:center}.promo-dot{display:none}.promo p{flex-basis:100%}}</style>

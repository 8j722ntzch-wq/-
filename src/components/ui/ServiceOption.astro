---
interface Props { name: string; value: string; label: string; checked?: boolean; disabled?: boolean; id?: string; }
const { name, value, label, checked = false, disabled = false, id = `option-${crypto.randomUUID()}` } = Astro.props;
---
<label class="option" for={id}>
  <input class="sr-only" id={id} type="checkbox" name={name} value={value} checked={checked} disabled={disabled} />
  <span>{label}</span>
</label>
<style>
  .option { position: relative; display: inline-flex; max-width: 100%; }
  .option span { display: flex; align-items: center; min-height: 42px; padding: 10.5px; border: 1.5px solid var(--color-green); border-radius: var(--radius-control); color: var(--color-white); font: 700 .875rem/1.3 var(--font-body); letter-spacing: 0em; overflow-wrap: anywhere; cursor: pointer; }
  input:checked + span { background: var(--color-green); color: var(--color-black); }
  input:focus-visible + span { outline: 3px solid var(--color-white); outline-offset: 4px; }
  input:disabled + span { border-color: var(--color-gray-3); color: var(--color-gray-3); background: transparent; cursor: not-allowed; }
  @media (hover: hover) and (pointer: fine) { input:not(:disabled):not(:checked) + span:hover { color: var(--color-green); text-decoration: underline; } }
  @media (max-width: 47.99rem) { .option span { min-height: 44px; font-size: .75rem; line-height: 1.2; } }
</style>

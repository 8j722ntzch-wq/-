---
interface Props { name:string; label?:string; value?:string; checked?:boolean; required?:boolean; disabled?:boolean; error?:string; }
const {name,label,value='yes',checked=false,required=false,disabled=false,error}=Astro.props;
const id='checkbox-'+crypto.randomUUID();
---
<div class="checkbox-field"><label class="checkbox"><input id={id} type="checkbox" name={name} value={value} checked={checked} required={required} disabled={disabled} aria-invalid={error?'true':undefined} aria-describedby={error?id+'-error':undefined}/><span class="checkbox__box" aria-hidden="true"></span><span><slot>{label}</slot></span></label>{error&&<p id={id+'-error'} class="checkbox-error">{error}</p>}</div>
<style>
.checkbox{display:flex;align-items:flex-start;gap:12px;cursor:pointer;position:relative;line-height:1.25}.checkbox input{position:absolute;width:24px;height:24px;opacity:0;margin:0}.checkbox__box{flex:none;width:24px;height:24px;border:1.5px solid var(--color-white);border-radius:2px;background:transparent;position:relative}.checkbox input:checked+.checkbox__box{background:var(--color-green)}.checkbox input:checked+.checkbox__box::after{content:"";position:absolute;inset:0;background:var(--color-black);mask:url('/assets/figma/tick.svg') center/22px no-repeat}.checkbox input:focus-visible+.checkbox__box{outline:3px solid currentColor;outline-offset:4px}.checkbox input:disabled+.checkbox__box{border-color:var(--color-gray-3);opacity:.4}.checkbox input:disabled~span{opacity:.4}.checkbox input[aria-invalid=true]+.checkbox__box{border-color:var(--color-error)}.checkbox-error{margin-top:8px;color:var(--color-error);font-size:14px}.checkbox:has(input:disabled){cursor:not-allowed}
.checkbox__box{pointer-events:none}
@media(hover:hover){.checkbox:hover input:not(:disabled):not(:checked):not([aria-invalid=true])+.checkbox__box{border-color:var(--color-green)}}@media(pointer:coarse){.checkbox{min-height:44px;align-items:center}}
</style>

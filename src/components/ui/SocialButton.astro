---
import Icon from './Icon.astro';
type Social='instagram'|'telegram'|'youtube';
interface Props { name:Social; href?:string; label?:string; }
const {name,href,label=name}=Astro.props;
---
{href
 ? <a class="social-button" href={href} aria-label={label}>
    <Icon name={name} size={24}/><Icon name={name+'-20'} size={20}/>
   </a>
 : <span class="social-button social-button--placeholder" title={label+' — ссылка будет добавлена позднее'} aria-label={label+': ссылка пока не указана'}>
    <Icon name={name} size={24}/><Icon name={name+'-20'} size={20}/>
   </span>
}
<style>
.social-button{display:grid;place-items:center;flex:none;width:48px;height:48px;border:1.5px solid var(--color-gray-6);border-radius:4px;background:transparent;color:inherit;text-decoration:none}
.social-button :global(.icon){grid-area:1/1}
.social-button :global(.icon:nth-child(2)){display:none}
a.social-button:hover,a.social-button:focus-visible{background:var(--color-green);border-color:var(--color-green);color:var(--color-black)}
@media(max-width:58rem){
.social-button{width:40px;height:40px}
.social-button :global(.icon:first-child){display:none}
.social-button :global(.icon:nth-child(2)){display:inline-block}
}
</style>

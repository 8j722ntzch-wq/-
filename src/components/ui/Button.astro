---
import '../../styles/button.css';
import Icon from './Icon.astro';
interface Props {
  type?: 'button' | 'submit' | 'reset';
  variant?: 'solid' | 'linear';
  size?: 's' | 'm' | 'l';
  disabled?: boolean;
  busy?: boolean;
  fullWidth?: boolean;
  id?: string;
  controls?: string;
  expanded?: boolean;
  icon?: boolean;
  openDialog?: string;
}
const { type = 'button', variant = 'solid', size = 'l', disabled = false, busy = false, fullWidth = false, id, controls, expanded, icon=false, openDialog } = Astro.props;
---
<button id={id} type={type} class:list={['button', `button--${variant}`, `button--${size}`, { 'button--full': fullWidth, 'button--split': icon }]} disabled={disabled || busy} aria-busy={busy || undefined} aria-controls={controls||openDialog} aria-haspopup={openDialog?'dialog':undefined} aria-expanded={expanded} data-open-dialog={openDialog}>
  <span class="button__label"><slot /></span>{icon&&<span class="button__icon"><Icon name="arrow" size={size==='s'?14:size==='m'?16:20}/></span>}
</button>

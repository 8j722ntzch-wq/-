---
interface Props { question: string; open?: boolean; }
const { question, open = false } = Astro.props;
---
<details class="accordion" open={open}>
  <summary><span class="accordion__question">{question}</span><span class="accordion__action" aria-hidden="true"><span class="when-closed">Открыть</span><span class="when-open">Закрыть</span></span></summary>
  <div class="accordion__answer"><slot /></div>
</details>
<style>
  .accordion { border: 1px solid var(--color-black); border-radius: var(--radius-control); }
  summary { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); min-height: 68px; padding: 19px; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  .accordion__question { font: 700 1.5rem/1.25 var(--font-heading); overflow-wrap: anywhere; }
  .accordion__action { flex: 0 0 auto; font: 500 .875rem/1.3 var(--font-body); }
  .accordion__answer { padding: 0 19px 19px; color: var(--color-gray-5); line-height: 1.5; overflow-wrap: anywhere; }
  details:not([open]) .when-open, details[open] .when-closed { display: none; }
  @media (hover: hover) and (pointer: fine) { summary:hover { text-decoration: underline; } details:hover { border-color: var(--color-green); } }
  @media (max-width: 47.99rem) { .accordion__question { font-size: 1.25rem; } summary { align-items: start; padding: 16px; } }
</style>

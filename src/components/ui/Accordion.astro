---
interface Props { question:string; open?:boolean; }
const {question,open=false}=Astro.props;
---
<details class="accordion" open={open}>
  <summary>
    <span class="accordion__question">{question}</span>
    <span class="accordion__action" aria-hidden="true"><span class="when-closed">Открыть</span><span class="when-open">Закрыть</span></span>
  </summary>
  <div class="accordion__answer"><slot/></div>
</details>
<style>
/* block_Accordion 88:2575: hover is a state of the WHOLE component. */
.accordion{border:1px solid var(--color-black);border-radius:4px;min-width:0}
summary{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:68px;padding:19px;cursor:pointer;list-style:none}
summary::-webkit-details-marker{display:none}
.accordion__question{font:700 24px/1.25 var(--font-heading);overflow-wrap:anywhere}
.accordion__action{flex:0 0 auto;font:500 14px/1.3 var(--font-body);text-decoration:underline}
.accordion__answer{padding:0 19px 19px;color:var(--color-gray-4);font:500 16px/1.25 var(--font-body);overflow-wrap:anywhere}
details:not([open]) .when-open,details[open] .when-closed{display:none}
@media(hover:hover) and (pointer:fine){
  .accordion:hover{border-color:var(--color-green)}
  .accordion:hover .accordion__question{text-decoration:underline}
}
@media(max-width:58rem){
  summary{min-height:64px;padding:19px;align-items:center}
  .accordion__question{font-size:20px;line-height:1.3}
  .accordion__answer{padding:0 19px 19px;font-size:14px;line-height:1.25}
}
</style>

---
import Modal from './Modal.astro';
import ConsultationForm from '../forms/ConsultationForm.astro';
interface Props { id?:string;policyDialog?:string;defaultService?:string; }
const {id='consultation',policyDialog,defaultService}=Astro.props;
---
<Modal id={id} variant="consultation" title="Расскажите, что нужно сделать" description="Опишите вещь и желаемый результат">
 <ConsultationForm dialog policyDialog={policyDialog} defaultService={defaultService}/>
</Modal>

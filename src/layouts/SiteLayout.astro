---
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';
import SuccessDialog from '../components/dialogs/SuccessDialog.astro';
import { indexingEnabled } from '../data/search';
interface Props { title:string;description:string; publicPage?:boolean; }
const {title,description,publicPage=true}=Astro.props;
const canonical = publicPage ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={publicPage && indexingEnabled ? 'index, follow' : 'noindex, nofollow'} />
    {canonical && <link rel="canonical" href={canonical} />}
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body id="top"><a class="skip-link" href="#content">К содержимому</a><slot /><SuccessDialog id="success"/></body>
</html>


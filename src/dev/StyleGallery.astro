---
import figma from '../data/figma-styles.json';
import Button from '../components/ui/Button.astro';
const typeKeys=['h1','h2','h3','h4','h5','h6','h7','h8','p1','p2','superscript','p-large','illustration-format'];
const palette=figma.variables.map(v=>{const c=v.valuesByMode['24:0'];return {name:v.name.replace('Colors/',''),hex:'#'+[c.r,c.g,c.b].map(n=>Math.round(n*255).toString(16).padStart(2,'0')).join('').toUpperCase()};});
---
<h3 class="type-h4">Коллекция цветов</h3>
<p class="kit-note">Variable collection · Mode 1 · 13 переменных</p>
<div class="palette">{palette.map(color=><article class="swatch"><div style={`background:${color.hex}`}></div><h4>{color.name}</h4><code>{color.hex}</code></article>)}</div>
<p class="kit-note">Отдельные цвета компонентов: «В наличии» #07A038 · портфолио #F96AC7 · ошибка #EF4435.</p>
<h3 class="type-h4">Все текстовые стили</h3>
<div class="type-list">{figma.text.map((style,i)=><article class="type-sample"><div><strong>{style.name}</strong><span>{style.fontName.family} / {style.fontSize}px / {style.fontName.variationSettings.wght}</span><code>.type-{typeKeys[i]}</code></div><p class={'type-'+typeKeys[i]}>Идеи, которые хочется носить</p></article>)}</div>
<h3 class="type-h4">Коллекция цветовых вариантов</h3>
<div class="themes">{[['milk','Молочный'],['white','Белый'],['blue','Синий'],['dark','Тёмный'],['green','Зелёный']].map(([tone,label])=><article class={'theme theme--'+tone}><p class="type-superscript">{label}</p><h4 class="type-h4">Мастерская идей</h4><p>Один язык — разные акценты.</p><Button size="s" openDialog="consultation" icon>Оставить заявку</Button></article>)}</div>
<div class="system-grid"><article class="style-panel"><h3 class="type-h5">Desktop grid</h3><p>1236 px · 12 колонок по 92 px · промежутки 12 px</p><div class="column-demo" aria-hidden="true">{Array.from({length:12},()=> <span></span>)}</div></article><article class="style-panel shadow-demo"><h3 class="type-h5">Shadow</h3><p>Четыре слоя синей тени из Figma.</p></article><article class="style-panel gradient-demo"><h3 class="type-h5">Градиент формы</h3><p>114,4556° · Blue → Black</p></article></div>
<div class="spacing-demo">{[4,8,12,16,20,24,36,80].map(space=><div><span style={`width:${space}px`}></span><code>{space}px</code></div>)}</div>
<p class="kit-note">Радиусы: 4 px / 500 px. Inter и JetBrains Mono подключены локально. Superscript — 14 — название в Figma; фактический размер этого стиля 12 px.</p>
<style>
.palette{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px}.swatch{border-radius:4px;overflow:hidden;background:var(--color-white);border:1px solid var(--color-gray-3);padding-bottom:12px}.swatch>div{height:96px}.swatch h4{font:600 12px/1.3 var(--font-heading);margin:12px}.swatch code{font-size:12px;margin:12px}.type-list{border-top:1px solid var(--color-gray-3)}.type-sample{display:grid;grid-template-columns:280px minmax(0,1fr);gap:24px;padding:20px 0;border-bottom:1px solid var(--color-gray-3)}.type-sample>div{display:grid;align-content:start;gap:4px;font-size:12px}.type-sample span{color:var(--color-gray-4)}.type-sample>p{overflow-wrap:anywhere}.themes{display:grid;grid-template-columns:repeat(auto-fit,minmax(215px,1fr));gap:12px}.theme{padding:20px;border-radius:4px;display:flex;flex-direction:column;align-items:start;gap:16px;border:1px solid var(--color-gray-3)}.theme>p:not(:first-child){font-size:14px}.theme :global(.button){margin-top:auto}.theme--milk{background:var(--color-milk)}.theme--white{background:var(--color-white)}.theme--blue{background:var(--color-blue);color:var(--color-white);border-color:transparent}.theme--dark{background:var(--color-black);color:var(--color-white);border-color:transparent}.theme--green{background:var(--color-green)}.theme--green :global(.button){--button-bg:var(--color-black);color:var(--color-green)}.theme--green :global(.button:hover){--button-bg:transparent;color:var(--color-black)}.theme--blue :global(.button:hover),.theme--dark :global(.button:hover){color:var(--color-green)}.system-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.style-panel{padding:24px;background:var(--color-white);border-radius:4px;display:grid;gap:16px;align-content:start}.style-panel p{font-size:14px}.shadow-demo{box-shadow:var(--shadow)}.gradient-demo{background:var(--gradient-application);color:var(--color-white)}.column-demo{display:grid;grid-template-columns:repeat(12,1fr);gap:4px}.column-demo span{height:50px;background:var(--color-blue);opacity:.3}.spacing-demo{display:flex;flex-wrap:wrap;gap:20px;align-items:end}.spacing-demo>div{display:grid;gap:8px;font-size:12px}.spacing-demo span{height:24px;background:var(--color-blue)}@media(max-width:64rem){.system-grid{grid-template-columns:1fr}}@media(max-width:40rem){.type-sample{grid-template-columns:1fr;gap:12px}.theme{min-height:220px}}
</style>
